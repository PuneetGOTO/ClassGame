# 開發啟動後可從 data/local-credentials.json 取得自動產生的管理金鑰。
# 正式環境請填入各自獨立、至少 24 字元的隨機值。
ADMIN_KEY=
HOST_SECRET=
# 留空會在 localhost 以伺服器的一個區網 IPv4 位址產生 QR Code。
# 正式活動請填實際入口，例如 http://192.168.1.20:3000 或 https://campus.example.edu。
PUBLIC_URL=
PORT=3000
BIND_ADDRESS=0.0.0.0
DB_PATH=data/game.sqlite
# 若需經反向代理，設成已知代理的跳數，例如 1。
TRUST_PROXY=0

